# Runtime
NODE_ENV=development
TZ=Asia/Shanghai
APP_PORT=3000

# Domains
API_DOMAIN=api.xxx.com
ADMIN_DOMAIN=admin.xxx.com
CERT_DOMAIN=cert.xxx.com
API_BASE_URL=https://api.xxx.com/api
ADMIN_WEB_BASE_URL=https://admin.xxx.com
CERT_PUBLIC_BASE_URL=https://cert.xxx.com
PUBLIC_CERT_BASE_URL=https://cert.xxx.com

# Backend
BACKEND_PORT=3000
JWT_SECRET=replace-with-a-long-random-secret-before-deploy
JWT_EXPIRES_IN=7d
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=replace-default-admin-password-before-deploy

# Admin Web
VITE_API_BASE_URL=https://api.xxx.com/api
VITE_APP_BASE_PATH=/

# Public H5
VITE_CERT_PUBLIC_BASE_URL=https://cert.xxx.com

# Local upload storage for test/demo environments.
# Production can switch these URLs to OSS later.
UPLOAD_DIR=/opt/gxkjy/uploads
UPLOAD_PUBLIC_BASE_URL=https://api.xxx.com/uploads
UPLOAD_MAX_FILE_SIZE_MB=10

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=guxin_quick_test
MYSQL_USER=guxin
MYSQL_PASSWORD=replace-with-strong-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
DATABASE_URL=mysql://guxin:replace-with-strong-mysql-password@127.0.0.1:3306/guxin_quick_test
DATABASE_URL_DOCKER=mysql://guxin:replace-with-strong-mysql-password@mysql:3306/guxin_quick_test

# OSS
OSS_REGION=oss-cn-placeholder
OSS_ENDPOINT=https://oss-cn-placeholder.aliyuncs.com
OSS_BUCKET=guxin-placeholder-bucket
OSS_ACCESS_KEY_ID=replace-with-aliyun-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-aliyun-access-key-secret
OSS_PUBLIC_BASE_URL=https://guxin-placeholder-bucket.oss-cn-placeholder.aliyuncs.com

# Manufacturer test values
TEST_MANUFACTURER_CODE=MFR001
TEST_DEVICE_SN=GXTEST001

# Upload security
UPLOAD_SIGN_TTL_SECONDS=300
UPLOAD_NONCE_TTL_SECONDS=300

# Backup
BACKUP_DIR=/backup
BACKUP_RETENTION_DAYS=14
